{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VibeMotionPro",
  "version": "0.2.0",
  "identifier": "com.alphafoxz.vibemotionpro",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "VibeMotionPro",
        "width": 400,
        "height": 580,
        "resizable": false,
        "center": true,
        "minimizable": true,
        "maximizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "resources": {
      "sidecar/mp-daemon.exe": "mp-daemon.exe",
      "sidecar/wintun.dll": "wintun.dll"
    },
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUzMUJCMEZDMTJCODQ4N0MKUldSOFNMZ1MvTEFiNDdhWEZMRWhpWGR0OXN2SDA2WURNdGlQNXJWcEsyMFhoeVR2M3Y4YW9OTS8K",
      "endpoints": [
        "https://github.com/AlphaFoxz/vibe-motion-pro/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
